---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Muestra una imagen real optimizada si `src` existe en src/assets/images;
// si no, cae a un cuadro gris con la proporción/tamaño sugerido.
interface Props {
  width: number;
  height: number;
  alt?: string;
  src?: string;
  class?: string;
  imgClass?: string;
  rounded?: boolean;
  dark?: boolean;
  fill?: boolean;
}

const {
  width,
  height,
  alt = '',
  src,
  class: className = '',
  imgClass = '',
  rounded = false,
  dark = false,
  fill = false,
} = Astro.props;

// Todas las imágenes de src/assets/images quedan disponibles por nombre.
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const entry = src ? images[`../assets/images/${src}`] : undefined;
const ratio = `${width} / ${height}`;
---

<div
  class:list={[
    'ph relative flex items-center justify-center overflow-hidden',
    rounded && 'rounded-xl',
    !entry && (dark ? 'ph--dark' : 'ph--light'),
    className,
  ]}
  style={fill ? undefined : `aspect-ratio: ${ratio};`}
  role={entry ? undefined : 'img'}
  aria-label={entry ? undefined : alt}
>
  {
    entry ? (
      <Image
        src={entry.default}
        alt={alt}
        width={width}
        height={height}
        densities={[1.5, 2]}
        class:list={['absolute inset-0 h-full w-full object-cover', imgClass]}
      />
    ) : (
      <>
        <svg
          class="absolute opacity-30"
          width="72"
          height="72"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M3 18l5-9 4 6 3-4 6 7z" />
          <circle cx="8" cy="6" r="2" />
        </svg>
        <span class="relative z-10 font-sans text-xs">{width} × {height}</span>
      </>
    )
  }
</div>

<style>
  .ph--light {
    background: #dadada;
    border: 1px solid #c9c9c9;
    color: #8a8a90;
  }
  .ph--dark {
    background: #26262a;
    color: #55555c;
  }
</style>
