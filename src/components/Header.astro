---
import type { Content } from '../i18n/utils';

interface Props {
  nav: Content['nav'];
}

const { nav } = Astro.props;
---

<header class="sticky top-0 z-50 bg-ink">
  <div class="container-x flex h-[76px] items-center justify-between">
    <a href="#inicio" class="flex items-center gap-3">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1E6FE0" stroke-width="2">
        <path d="M3 18l5-9 4 6 3-4 6 7z" />
      </svg>
      <span class="font-display text-xl font-bold uppercase tracking-[0.15em] text-white">
        {nav.brand}
      </span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex">
      {
        nav.links.map((link) => (
          <a href={`#${link.id}`} class="nav-link text-white/85 hover:text-accent">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-4">
      <a href="#contacto" class="btn btn-primary hidden px-5 py-2.5 sm:inline-block">
        {nav.cta}
      </a>
      <button
        type="button"
        id="nav-toggle"
        class="lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F5F5F5" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-white/10 bg-ink lg:hidden">
    <div class="container-x flex flex-col gap-1 py-4">
      {
        nav.links.map((link) => (
          <a
            href={`#${link.id}`}
            class="nav-link block py-2 text-white/85 hover:text-accent"
            data-nav-item
          >
            {link.label}
          </a>
        ))
      }
      <a href="#contacto" class="btn btn-primary mt-3 text-center" data-nav-item>{nav.cta}</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  menu?.querySelectorAll('[data-nav-item]').forEach((item) => {
    item.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
