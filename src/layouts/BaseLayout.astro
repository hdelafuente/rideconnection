---
import '../styles/global.css';
import { defaultLocale } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = '', lang = defaultLocale } = Astro.props;
// El atributo lang del HTML usa el código de idioma base (es), no la región.
const htmlLang = lang.split('-')[0];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
